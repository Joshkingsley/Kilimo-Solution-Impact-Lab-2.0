# Copy to .env (git-ignored) and fill in. Never commit real values.

# Africa's Talking — use username "sandbox" with a SANDBOX API key for testing.
# Live account: your AT username + live key + approved sender ID / shortcode.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Server-side secret used to HMAC phone numbers. Generate: openssl rand -hex 32
MSISDN_HMAC_SECRET=

# Set to 1 to compute replies without sending SMS (default when AT_API_KEY is empty).
DRY_RUN=

# LLM (SPEC §9.3). Empty ANTHROPIC_API_KEY = rule-based replies only ("rules-v1").
ANTHROPIC_API_KEY=
NITAPATA_MODEL=claude-haiku-4-5
# Set to 0 to force rule-based replies even when a key is present (tests/offline demo).
NITAPATA_USE_LLM=1

# Retrieval (SPEC §7.2) — filters the corpus to this scheme cycle.
CURRENT_CYCLE=2026-SR
# Seconds a pending clarifying question stays open before the thread resets.
CLARIFY_TTL_SECONDS=900

# Cloudflare Worker secrets are set with `wrangler secret put`, not here:
#   ANTHROPIC_API_KEY, AT_API_KEY, AT_USERNAME, MSISDN_HMAC_SECRET

# ----------------------------------------------------------------------------
# RAG service (app/rag) — see docs/RAG.md
# ----------------------------------------------------------------------------
# LLM_PROVIDER=anthropic            # anthropic | fake (rule-based stub: tests/offline demo only)
# ANTHROPIC_API_KEY=                # required when LLM_PROVIDER=anthropic (or use `ant auth login`)
# ANTHROPIC_MODEL=claude-haiku-4-5  # SPEC §9.3
# EMBEDDING_PROVIDER=local          # local | cloudflare | voyage — rebuild the index when this changes
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# VOYAGE_API_KEY=
# CURRENT_CYCLE=2026-SR             # SPEC §7.2 — retrieval filters to this cycle (+ cycle-independent docs)
# DEFAULT_COUNTY=                   # leave empty: the pipeline asks one clarifying question instead
# RAG_API_KEYS=                     # comma-separated client keys for /v1/rag/*  (empty = service refuses requests)
# RAG_ADMIN_API_KEYS=               # keys allowed to POST /v1/rag/ingest
# RATE_LIMIT_PER_MINUTE=60
# MAX_MESSAGE_CHARS=1000
# ALLOW_FAKE_LLM_IN_API=false
# CORS_ORIGINS=
